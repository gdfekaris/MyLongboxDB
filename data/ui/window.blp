using Gtk 4.0;
using Adw 1;

template $MainWindow: Adw.ApplicationWindow {
  title: _("MyLongboxDB");
  default-width: 1100;
  default-height: 720;
  width-request: 360;
  height-request: 294;

  Adw.Breakpoint {
    condition ("max-width: 640sp")

    setters {
      split_view.collapsed: true;
    }
  }

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.ViewStack stack {
      Adw.ViewStackPage {
        name: "welcome";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            show-title: false;
          }

          content: Adw.StatusPage {
            icon-name: "io.github.gdfekaris.MyLongboxDB";
            title: _("Welcome to MyLongboxDB");
            description: _("Catalog and search your comics, magazines, and collected editions. Everything stays on this computer.");

            child: Box {
              orientation: vertical;
              spacing: 12;
              halign: center;

              Button {
                label: _("_Create New Collection");
                use-underline: true;
                action-name: "win.new-collection";

                styles [
                  "pill",
                  "suggested-action",
                ]
              }

              Button {
                label: _("_Import Collection File…");
                use-underline: true;
                action-name: "win.import-collection";

                styles [
                  "pill",
                ]
              }
            };
          };
        };
      }

      Adw.ViewStackPage {
        name: "collection";

        child: Adw.NavigationSplitView split_view {
          sidebar: Adw.NavigationPage {
            title: _("MyLongboxDB");

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {}

              content: ScrolledWindow {
                hscrollbar-policy: never;

                child: ListBox sidebar {
                  selection-mode: single;

                  styles [
                    "navigation-sidebar",
                  ]
                };
              };
            };
          };

          content: Adw.NavigationPage content_page {
            title: _("Everything");

            child: Adw.NavigationView content_nav {
              Adw.NavigationPage section_page {
                tag: "section";
                title: _("Everything");

                child: Adw.ToolbarView {
                  [top]
                  Adw.HeaderBar content_header {
                    [start]
                    Button back_button {
                      icon-name: "go-previous-symbolic";
                      tooltip-text: _("Back");
                      action-name: "win.shelf-back";
                      visible: false;
                    }

                    [start]
                    ToggleButton search_toggle {
                      icon-name: "system-search-symbolic";
                      tooltip-text: _("Search");
                    }

                    [start]
                    ToggleButton filter_toggle {
                      label: _("_Filters");
                      use-underline: true;
                      tooltip-text: _("Filter by Any Field");
                    }

                    title-widget: Adw.WindowTitle window_title {
                      title: _("Everything");
                    };

                    [end]
                    MenuButton {
                      icon-name: "open-menu-symbolic";
                      menu-model: main_menu;
                      primary: true;
                      tooltip-text: _("Main Menu");
                    }

                    [end]
                    MenuButton {
                      icon-name: "list-add-symbolic";
                      tooltip-text: _("Add");
                      menu-model: add_menu;
                    }

                    [end]
                    MenuButton entry_menu_button {
                      icon-name: "view-more-symbolic";
                      tooltip-text: _("Manage This Entry");
                      menu-model: entry_menu;
                      visible: false;
                    }

                    [end]
                    MenuButton sort_button {
                      icon-name: "view-sort-descending-symbolic";
                      tooltip-text: _("Sort");
                      menu-model: sort_menu;
                    }

                    [end]
                    ToggleButton select_toggle {
                      icon-name: "selection-mode-symbolic";
                      tooltip-text: _("Select");
                    }

                    [end]
                    Adw.ToggleGroup view_toggle {
                      active-name: "grid";

                      styles [
                        "flat",
                      ]

                      Adw.Toggle {
                        name: "grid";
                        icon-name: "view-grid-symbolic";
                        tooltip: _("Cover Grid");
                      }

                      Adw.Toggle {
                        name: "list";
                        icon-name: "view-list-symbolic";
                        tooltip: _("List");
                      }
                    }
                  }

                  [top]
                  SearchBar search_bar {
                    search-mode-enabled: bind search_toggle.active bidirectional;

                    child: Adw.Clamp {
                      maximum-size: 560;

                      child: SearchEntry search_entry {
                        placeholder-text: _("Search series, titles, people, characters, tags, notes…");
                        search-delay: 150;
                        hexpand: true;
                      };
                    };
                  }

                  [top]
                  Revealer filter_revealer {
                    reveal-child: bind filter_toggle.active;
                    transition-type: slide_down;

                    child: Adw.Bin filter_bin {
                      styles [
                        "toolbar",
                      ]
                    };
                  }

                  [top]
                  Adw.Banner correction_banner {
                    button-label: _("_Use This Spelling");
                    use-markup: false;
                  }

                  [top]
                  Adw.Banner rates_banner {
                    button-label: _("_Update Rates");
                    action-name: "win.edit-rates";
                    use-markup: false;
                  }

                  [bottom]
                  ActionBar results_bar {
                    revealed: false;

                    [start]
                    Label results_label {
                      ellipsize: end;

                      styles [
                        "caption",
                        "dim-label",
                        "numeric",
                      ]
                    }
                  }

                  [bottom]
                  ActionBar selection_bar {
                    revealed: false;

                    [start]
                    Label selection_label {}

                    [end]
                    Button {
                      label: _("_Edit Selected…");
                      use-underline: true;
                      action-name: "win.bulk-edit";

                      styles [
                        "suggested-action",
                      ]
                    }

                    [end]
                    Button {
                      label: _("Move to _Trash");
                      use-underline: true;
                      action-name: "win.trash-selected";
                    }
                  }

                  content: Stack content_stack {
                    StackPage {
                      name: "grid";

                      child: ScrolledWindow grid_scroller {
                        hscrollbar-policy: never;
                      };
                    }

                    StackPage {
                      name: "list";

                      child: ScrolledWindow list_scroller {};
                    }

                    StackPage {
                      name: "names";

                      child: ScrolledWindow names_scroller {
                        hscrollbar-policy: never;
                      };
                    }

                    StackPage {
                      name: "custom";

                      child: Adw.Bin custom_bin {};
                    }

                    StackPage {
                      name: "empty";

                      child: Adw.StatusPage empty_page {
                        icon-name: "io.github.gdfekaris.MyLongboxDB";
                      };
                    }
                  };
                };
              }
            };
          };
        };
      }
    };
  };
}

menu entry_menu {
  section {
    item {
      label: _("_Rename…");
      action: "win.rename-entry";
    }

    item {
      label: _("_Alternate Names…");
      action: "win.entry-aliases";
    }

    item {
      label: _("_Merge Into…");
      action: "win.merge-entry";
    }
  }

  section {
    item {
      label: _("_Delete…");
      action: "win.delete-entry";
    }
  }
}

menu sort_menu {
  section {
    item {
      label: _("_Usual Order");
      action: "win.sort";
      target: "usual";
    }

    item {
      label: _("_Cover Date");
      action: "win.sort";
      target: "cover-date";
    }

    item {
      label: _("_Grade");
      action: "win.sort";
      target: "grade";
    }

    item {
      label: _("Current _Value");
      action: "win.sort";
      target: "value";
    }

    item {
      label: _("_Purchase Date");
      action: "win.sort";
      target: "purchase-date";
    }

    item {
      label: _("Date _Added");
      action: "win.sort";
      target: "added";
    }
  }

  section {
    item {
      label: _("_Reverse Order");
      action: "win.sort-reversed";
    }
  }
}

menu add_menu {
  section {
    item {
      label: _("Add _Comic");
      action: "win.add-comic";
    }

    item {
      label: _("Add _Magazine");
      action: "win.add-magazine";
    }

    item {
      label: _("Add Co_llected Edition");
      action: "win.add-collected";
    }
  }
}

menu main_menu {
  section {
    item {
      label: _("_New Collection…");
      action: "win.new-collection";
    }

    item {
      label: _("_Import Collection File…");
      action: "win.import-collection";
    }

    item {
      label: _("_Export a Copy…");
      action: "win.export-collection";
    }
  }

  section {
    item {
      label: _("Import _Books from CSV…");
      action: "win.import-books";
    }

    item {
      label: _("Export Collection as _CSV…");
      action: "win.export-csv";
    }

    item {
      label: _("Export _Shown Books as CSV…");
      action: "win.export-shown-csv";
    }

    item {
      label: _("_Full Export with Photos…");
      action: "win.export-zip";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "win.preferences";
    }

    item {
      label: _("Customize _Sidebar…");
      action: "win.customize-sidebar";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "win.shortcuts";
    }
  }
}
